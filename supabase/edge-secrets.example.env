# Copiază acest fișier ca edge-secrets.local.env, completează valorile și NU îl urca pe GitHub.
# SUPABASE_URL este furnizat automat funcțiilor de Supabase.
# Poți folosi cheia legacy service_role sau secret key-ul nou al proiectului.
SUPABASE_SERVICE_ROLE_KEY=CHEIA_SERVICE_ROLE_SAU_SECRET_DIN_NOUl_PROIECT

# Botul principal trebuie să fie membru pe serverul Discord principal.
DISCORD_BOT_TOKEN=TOKEN_BOT_DISCORD_PRINCIPAL

# ID-urile Discord ale proprietarilor platformei, separate prin virgulă.
PLATFORM_OWNER_DISCORD_IDS=ID_UL_TAU_DISCORD

# Completează doar dacă folosești și Discord Secundar; altfel lasă gol.
DISCORD_SECONDARY_BOT_TOKEN=

# Trebuie să fie aceeași valoare folosită de jobul cron care apelează close-expired-shifts.
CRON_SECRET=GENEREAZA_UN_SECRET_LUNG_ALEATORIU_MINIM_32_CARACTERE

# Opționale: configuratorul salvează webhook-urile în baza de date.
# Acestea sunt doar valori de rezervă pentru funcțiile Edge.
DISCORD_FAMILY_WEBHOOK_URL=
DISCORD_MECHANICS_WEBHOOK_URL=
DISCORD_PONTAJ_WEBHOOK_URL=
DISCORD_WEEKLY_REPORT_WEBHOOK_URL=
